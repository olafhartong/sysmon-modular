<Sysmon schemaversion="4.30">
  <EventFiltering>
    <RuleGroup name="technique_id=T1547.001,technique_name=Registry Run Keys / Startup Folder" groupRelation="or">
      <FileCreate onmatch="include">
        <TargetFilename condition="contains">\Startup</TargetFilename>        <!--Microsoft:Office: Changes to user's autoloaded files under AppData-->
      </FileCreate>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
