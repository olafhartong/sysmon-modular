<Sysmon schemaversion="4.90">
  <EventFiltering>
    <RuleGroup name="Mission-important credential dump artifacts" groupRelation="or">
      <FileCreate onmatch="include">
        <Rule name="technique_id=T1003.003,technique_name=NTDS" groupRelation="and">
          <TargetFilename condition="end with">\ntds.dit</TargetFilename>
          <TargetFilename condition="is not">C:\Windows\NTDS\ntds.dit</TargetFilename>
        </Rule>
        <Rule name="technique_id=T1003.002,technique_name=Security Account Manager" groupRelation="and">
          <TargetFilename condition="end with">\SAM</TargetFilename>
          <TargetFilename condition="is not">C:\Windows\System32\config\SAM</TargetFilename>
        </Rule>
        <Rule name="technique_id=T1003.004,technique_name=LSA Secrets" groupRelation="and">
          <TargetFilename condition="end with">\SECURITY</TargetFilename>
          <TargetFilename condition="is not">C:\Windows\System32\config\SECURITY</TargetFilename>
        </Rule>
        <Rule name="technique_id=T1003,technique_name=OS Credential Dumping" groupRelation="and">
          <TargetFilename condition="end with">\SYSTEM</TargetFilename>
          <TargetFilename condition="is not">C:\Windows\System32\config\SYSTEM</TargetFilename>
        </Rule>
      </FileCreate>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
