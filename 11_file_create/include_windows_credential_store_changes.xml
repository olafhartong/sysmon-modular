<Sysmon schemaversion="4.90">
  <EventFiltering>
    <RuleGroup name="Mission-important Windows credential store changes" groupRelation="or">
      <FileCreate onmatch="include">
        <TargetFilename name="technique_id=T1555.004,technique_name=Windows Credential Manager" condition="contains">\Microsoft\Credentials\</TargetFilename>
        <TargetFilename name="technique_id=T1555.004,technique_name=Windows Credential Manager" condition="contains">\Microsoft\Vault\</TargetFilename>
        <TargetFilename name="technique_id=T1555.004,technique_name=Windows Credential Manager" condition="contains">\Microsoft\Protect\</TargetFilename>
        <TargetFilename name="technique_id=T1552.004,technique_name=Private Keys" condition="begin with">C:\ProgramData\Microsoft\Crypto\</TargetFilename>
        <TargetFilename name="technique_id=T1552.004,technique_name=Private Keys" condition="begin with">C:\Windows\System32\Microsoft\Protect\</TargetFilename>
      </FileCreate>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
