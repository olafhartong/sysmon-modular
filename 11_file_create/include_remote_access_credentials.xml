<Sysmon schemaversion="4.90">
  <EventFiltering>
    <RuleGroup name="Mission-important remote access credential files" groupRelation="or">
      <FileCreate onmatch="include">
        <TargetFilename name="technique_id=T1552.001,technique_name=Credentials In Files" condition="contains all">\AppData\Roaming\FileZilla\;sitemanager.xml</TargetFilename>
        <TargetFilename name="technique_id=T1552.001,technique_name=Credentials In Files" condition="contains all">\Documents\SuperPuTTY\;Sessions.xml</TargetFilename>
        <TargetFilename name="technique_id=T1552.001,technique_name=Credentials In Files" condition="contains all">\AppData\Roaming\doctl\;config.yaml</TargetFilename>
        <TargetFilename name="technique_id=T1552.001,technique_name=Credentials In Files" condition="contains all">\.oci\;config</TargetFilename>
        <TargetFilename name="technique_id=T1552.004,technique_name=Private Keys" condition="contains all">\.oci\;.pem</TargetFilename>
      </FileCreate>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
