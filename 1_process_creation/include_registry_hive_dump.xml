<Sysmon schemaversion="4.90">
  <EventFiltering>
    <RuleGroup name="Mission-important registry hive dump" groupRelation="or">
      <ProcessCreate onmatch="include">
        <Rule name="technique_id=T1003.002,technique_name=Security Account Manager" groupRelation="and">
          <OriginalFileName condition="is">reg.exe</OriginalFileName>
          <CommandLine condition="contains any"> save ; export </CommandLine>
          <CommandLine condition="contains any">HKLM\SAM;HKEY_LOCAL_MACHINE\SAM</CommandLine>
        </Rule>
        <Rule name="technique_id=T1003.004,technique_name=LSA Secrets" groupRelation="and">
          <OriginalFileName condition="is">reg.exe</OriginalFileName>
          <CommandLine condition="contains any"> save ; export </CommandLine>
          <CommandLine condition="contains any">HKLM\SECURITY;HKEY_LOCAL_MACHINE\SECURITY</CommandLine>
        </Rule>
        <Rule name="technique_id=T1003,technique_name=OS Credential Dumping" groupRelation="and">
          <OriginalFileName condition="is">reg.exe</OriginalFileName>
          <CommandLine condition="contains any"> save ; export </CommandLine>
          <CommandLine condition="contains any">HKLM\SYSTEM;HKEY_LOCAL_MACHINE\SYSTEM</CommandLine>
        </Rule>
      </ProcessCreate>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
