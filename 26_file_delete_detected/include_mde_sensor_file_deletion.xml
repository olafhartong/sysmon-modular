<Sysmon schemaversion="4.90">
  <EventFiltering>
    <RuleGroup name="technique_id=T1685,technique_name=Disable or Modify Tools" groupRelation="or">
      <FileDeleteDetected onmatch="include">
        <Rule groupRelation="and">
          <TargetFilename condition="contains">\Microsoft\Windows Defender Advanced Threat Protection\</TargetFilename>
          <Image condition="excludes any">\Windows Defender Advanced Threat Protection\;\Windows Defender\</Image>
        </Rule>
      </FileDeleteDetected>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
