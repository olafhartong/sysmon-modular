<Sysmon schemaversion="4.90">
  <EventFiltering>
    <RuleGroup name="Windows telemetry controller persistence" groupRelation="or">
      <RegistryEvent onmatch="include">
        <TargetObject name="technique_id=T1112,technique_name=Modify Registry" condition="begin with">HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\AppCompatFlags\TelemetryController</TargetObject>
      </RegistryEvent>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
