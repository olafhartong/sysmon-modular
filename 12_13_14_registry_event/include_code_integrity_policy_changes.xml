        <TargetObject name="technique_id=T1553.006,technique_name=Code Signing Policy Modification" condition="begin with">HKLM\SOFTWARE\Policies\Microsoft\Windows\Safer\CodeIdentifiers\</TargetObject>
        <TargetObject name="technique_id=T1553.006,technique_name=Code Signing Policy Modification" condition="begin with">HKLM\SYSTEM\CurrentControlSet\Control\CI\Policy\</TargetObject>
        <TargetObject name="technique_id=T1685,technique_name=Disable or Modify Tools" condition="begin with">HKLM\SOFTWARE\Policies\Microsoft\Windows\DeviceInstall\Restrictions\</TargetObject>
        <TargetObject name="technique_id=T1553.006,technique_name=Code Signing Policy Modification" condition="begin with">HKLM\SYSTEM\CurrentControlSet\Control\DeviceGuard\</TargetObject>
      </RegistryEvent>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
