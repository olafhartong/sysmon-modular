<Sysmon schemaversion="4.30">
	<EventFiltering>
		<RuleGroup name="technique_id=T1559.002,technique_name=Dynamic Data Exchange" groupRelation="or">
			<RegistryEvent onmatch="include">
				<!--Microsoft:Office:Security _features-->
				<!--https://msrc.microsoft.com/update-guide/vulnerability/ADV170021-->
				<TargetObject condition="end with">\Word\Security\AllowDDE</TargetObject>
				<TargetObject condition="end with">\Excel\Security\DisableDDEServerLaunch</TargetObject>
				<TargetObject condition="end with">\Excel\Security\DisableDDEServerLookup</TargetObject>
			</RegistryEvent>
		</RuleGroup>
	</EventFiltering>
</Sysmon>
